DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_copilot
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
ENVIRONMENT=local

# Required on /chat and /incidents (docs/threat-model.md Finding #1).
# "dev-local-key" is an obvious default for local dev only -- override
# for any real deployment.
API_KEY=dev-local-key
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_INCIDENTS=60/minute

# MCP (Phase 9) -- wraps live incident-status lookup as a real MCP server.
# Run it separately: python -m app.mcp_server (see docker-compose.yml's
# mcp-server service for the containerized version). Disabled by default;
# live_node falls back to a direct DB call if disabled or unreachable.
MCP_ENABLED=false
MCP_SERVER_URL=http://localhost:8100/mcp
